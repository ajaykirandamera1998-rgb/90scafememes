<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BESTA - Build Your Bathukamma</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Poppins:wght@400;600&display=swap" rel="stylesheet">
<style>
  body{font-family:\'Poppins\', sans-serif; background:#FFF9F0}
  .besta-bg{background:#3E2314}
  .bathukamma-ring{
    border-radius: 50%;
    background-repeat: repeat;
    background-position: center;
    background-size: 38px;
    box-shadow: 0 6px 12px rgba(0,0,0,0.25), inset 0 -10px 18px rgba(0,0,0,0.22);
    border: 2px solid rgba(255,255,255,0.5);
    margin-top: -20px;
    position: relative;
  }
  .plate{
    background: radial-gradient(ellipse at center, #FFE9A8 0%, #D4A017 35%, #8B5A00 75%, #5C3A00 100%);
    border: 3px solid #5C3A00;
    box-shadow: 0 12px 24px rgba(0,0,0,0.35);
  }
</style>
</head>
<body>

<header class="bg-white border-b sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="logo.png" class="h-10 object-contain">
      <div>
        <h1 class="font-bold text-xl tracking-widest" style="font-family:\'Cormorant Garamond\'; color:#3E2314">BESTA</h1>
        <p class="text-[10px] tracking-[0.2em] text-[#8B5A00] -mt-1">THE INDIAN KITCHEN</p>
      </div>
    </div>
    <p class="hidden md:block text-xs bg-[#FFF1D6] px-4 py-2 rounded-full">Build your Bathukamma & get your festive card ✨</p>
  </div>
</header>

<div class="max-w-6xl mx-auto p-4 md:p-6 grid md:grid-cols-2 gap-6">
  <div class="bg-white rounded-[24px] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.08)]">
    <h2 class="font-bold" style="color:#3E2314">1. Tap to add a layer</h2>
    <p class="text-xs text-gray-500 mb-3">Bottom layer is widest. Build 5-7 rings. Tap ring to remove.</p>
    <div id="palette" class="grid grid-cols-5 gap-2.5"></div>
    <div class="mt-5 flex gap-2">
      <input id="custName" placeholder="Your Name (for card)" class="flex-1 border-2 border-[#F3E6C8] rounded-full px-4 py-2.5 text-sm outline-none">
      <button onclick="clearAll()" class="px-5 py-2.5 rounded-full bg-gray-100 text-sm">Clear</button>
    </div>
    <button onclick="generate()" class="w-full mt-3 besta-bg text-white py-3.5 rounded-full font-bold">CREATE MY FESTIVE CARD →</button>
    <p class="text-[11px] text-center text-gray-400 mt-2">Premium HD card • Ready for Instagram Story</p>
  </div>

  <div class="bg-white rounded-[24px] p-5 shadow-[0_10px_30px_rgba(0,0,0,0.08)] flex flex-col items-center">
    <h2 class="font-bold mb-3" style="color:#3E2314">2. Your Bathukamma</h2>
    <div id="stage" class="w-[340px] h-[440px] rounded-[24px] border border-[#F3E6C8] bg-gradient-to-b from-[#FFFCF2] to-[#FFEFD1] flex flex-col items-center justify-end pb-10 relative overflow-hidden">
      <div id="stack" class="flex flex-col items-center w-full pb-1" style="filter: drop-shadow(0 12px 18px rgba(0,0,0,0.18));"></div>
      <div class="plate w-[318px] h-[46px] rounded-[50%] absolute bottom-3 z-0 flex items-center justify-center">
        <div class="w-[295px] h-[24px] rounded-[50%] border border-white/50 bg-white/15"></div>
      </div>
      <p id="hint" class="absolute top-1/2 -translate-y-1/2 text-xs bg-white px-4 py-2 rounded-full shadow text-gray-500">Tap flowers to start building</p>
    </div>
  </div>
</div>

<div id="modal" class="fixed inset-0 bg-black/75 hidden items-center justify-center p-4 z-50">
  <div class="text-center">
    <div id="captureCard" class="w-[360px] bg-[#FFFBF0] rounded-[22px] overflow-hidden border-[5px] border-[#3E2314]">
      <div class="besta-bg text-white py-5 px-4 text-center">
        <img src="logo.png" class="h-10 mx-auto mb-2 brightness-0 invert">
        <p class="text-[10px] tracking-[0.35em] opacity-80">HAPPY BATHUKAMMA</p>
        <h2 class="text-2xl font-bold tracking-wide" style="font-family:\'Cormorant Garamond\'">BESTA</h2>
        <p class="text-[9px] tracking-[0.2em] opacity-60">THE INDIAN KITCHEN</p>
      </div>
      <div id="cardStackWrap" class="h-[380px] bg-gradient-to-b from-[#FFFCF2] to-[#FFE9B8] relative flex flex-col items-center justify-end pb-8 p-4"></div>
      <div class="bg-white p-5 text-center">
        <h3 id="cardName" class="font-bold text-lg" style="font-family:\'Cormorant Garamond\'; color:#3E2314"></h3>
        <p class="text-xs text-gray-600 mt-1">May your life be as colourful & joyful<br>as the Bathukamma</p>
        <div class="mt-4 pt-3 border-t border-dashed flex justify-between">
          <p class="text-[9px] text-gray-400 text-left">Celebrating Telangana\'s<br>Flower Festival with you</p>
          <p class="text-[9px] font-bold text-right" style="color:#3E2314">BESTA - THE INDIAN KITCHEN<br><span class="font-normal text-gray-500">@besta.indiankitchen</span></p>
        </div>
      </div>
    </div>
    <button onclick="downloadCard()" class="mt-5 bg-white text-[#3E2314] px-8 py-3.5 rounded-full font-bold w-[360px]">⬇️ Download HD Card</button>
    <button onclick="closeM()" class="block mx-auto mt-3 text-white/70 text-sm">Build Another</button>
  </div>
</div>

<script>
// YOUR EXACT 10 NAMES - DO NOT RENAME
const flowers = [
 { name:"Banthi", img:"banthi.png" },
 { name:"Chamanthi", img:"chamanthi.png" },
 { name:"Gulabi", img:"gulabi.png" },
 { name:"Gunuka", img:"gunuka.png" },
 { name:"Nandi", img:"nandi.png" },
 { name:"Surya", img:"surya.png" },
 { name:"Tangedu", img:"tangedu.png" },
 { name:"Katla", img:"katla.png" },
 { name:"Billa", img:"billa.png" },
 { name:"Teku", img:"teku.png" },
];

const palette = document.getElementById(\'palette\');
flowers.forEach((f,i)=>{
  palette.innerHTML += `
  <button onclick="addRing(${i})" class="bg-[#FFFBF0] rounded-2xl p-2 border border-[#F3E6C8] hover:border-[#D4A017] flex flex-col items-center">
    <img src="${f.img}" class="w-11 h-11 object-contain" onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'block\'">
    <span style="display:none; font-size:20px">🌼</span>
    <span class="text-[10px] font-semibold mt-1" style="color:#3E2314">${f.name}</span>
  </button>`
});

let layerCount = 0;
const widths = [282, 252, 222, 192, 162, 128, 92, 58];
function addRing(i){
 document.getElementById(\'hint\').style.display=\'none\';
 if(layerCount >= 8) return alert("8 layers is max!");
 const stack = document.getElementById(\'stack\');
 const w = widths[layerCount];
 const h = w * 0.36;
 const ring = document.createElement(\'div\');
 ring.className = "bathukamma-ring";
 ring.style.width = w+"px"; ring.style.height = h+"px";
 ring.style.backgroundImage = `url(${flowers[i].img})`;
 ring.style.zIndex = 20 - layerCount;
 ring.onclick = function(){ this.remove(); reStack(); }
 stack.appendChild(ring);
 layerCount++;
}
function reStack(){
  const rings = document.querySelectorAll(\'#stack .bathukamma-ring\');
  rings.forEach((r, idx)=>{
    r.style.width = widths[idx]+"px";
    r.style.height = widths[idx]*0.36+"px";
    r.style.zIndex = 20 - idx;
  });
  layerCount = rings.length;
  if(layerCount==0) document.getElementById(\'hint\').style.display=\'block\';
}
function clearAll(){
 document.getElementById(\'stack\').innerHTML=""; layerCount=0;
 document.getElementById(\'hint\').style.display=\'block\';
}
function generate(){
 if(layerCount < 4) return alert("Add at least 4 layers for beautiful cone");
 document.getElementById(\'cardName\').innerText = document.getElementById(\'custName\').value || "A Loved Guest";
 document.getElementById(\'cardStackWrap\').innerHTML = document.getElementById(\'stack\').innerHTML + `<div class="plate w-[300px] h-[36px] rounded-[50%] absolute bottom-3"></div>`;
 document.getElementById(\'modal\').classList.remove(\'hidden\'); document.getElementById(\'modal\').classList.add(\'flex\');
}
function closeM(){ document.getElementById(\'modal\').classList.add(\'hidden\'); document.getElementById(\'modal\').classList.remove(\'flex\'); }
function downloadCard(){
 html2canvas(document.getElementById(\'captureCard\'), {scale:3, useCORS:true}).then(c=>{
   let a=document.createElement(\'a\'); a.download=`BESTA-Bathukamma.png`; a.href=c.toDataURL(); a.click();
 });
}
</script>
</body>
</html>
